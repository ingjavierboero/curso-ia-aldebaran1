# Copiar a .env y completar. Nunca commitear .env.
# Las rutas relativas se toman desde la raíz del repo (donde está este archivo).

# Claude (clasificación de comprobantes)
ANTHROPIC_API_KEY=

# Casilla Gmail con contraseña de aplicación (SMTP + IMAP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ARCA — solo homologación
ARCA_CUIT=
ARCA_CERT_PATH=./certs/arca.crt
ARCA_KEY_PATH=./certs/arca.key

# Opcionales
PORT=3000
DATABASE_PATH=./data/aldebaran.db
# Solo desarrollo: manda TODOS los emails a esta casilla en vez de a los clientes.
EMAIL_REDIRECT_TO=
